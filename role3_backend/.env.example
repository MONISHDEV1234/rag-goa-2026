# Environment Configuration — Role 3 Backend
# Copy this to .env and fill in real values. NEVER commit .env to git.

# --- Groq LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192          # Flexible: change to any Groq-supported model

# --- Sarvam STT (used by /api/voice endpoint) ---
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Retrieval (tuning knobs) ---
RETRIEVAL_TOP_K=3
CONTEXT_SIMILARITY_THRESHOLD=0.50  # Below this → missing-context refusal (tune with real data)

# --- Reliability ---
MAX_RETRIES=3                       # Tenacity max attempts on transient Groq failures
