# Environment Configuration — HH Goa 2026 Voice RAG Backend
# Copy this to .env and fill in real values. NEVER commit .env to git.

# --- Groq LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192          # Flexible: change to any Groq-supported model

# --- Sarvam STT (used by /api/voice endpoint — Role 2 integration) ---
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Role 1 FAISS Retrieval ---
# Path to the directory containing faiss.index, chunk_meta.jsonl, model_info.json
# Generated by: python role1/embed_index.py --chunks data/chunks/... --output-dir data/index
FAISS_INDEX_DIR=data/index

# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=3

# Context similarity threshold: below this score → missing-context refusal.
# Safe default for intfloat/multilingual-e5-large on MSMARCO-XI: 0.20
# Tune experimentally using: python role1/evaluate.py --index-dir data/index
CONTEXT_SIMILARITY_THRESHOLD=0.35

# Anti-hallucination pre-filter: drop chunks below this score before LLM call.
# 0.0 = disabled (let the context guard threshold handle low-quality chunks)
RETRIEVAL_MIN_SCORE=0.0

# --- Reliability ---
MAX_RETRIES=3                       # Tenacity max attempts on transient Groq failures
