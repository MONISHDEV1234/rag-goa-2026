# Environment Configuration — HH Goa 2026 Voice RAG Backend
# Generated from .env.example — fill in your real API keys.

# --- Groq LLM ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# --- Sarvam STT ---
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Role 1 FAISS Retrieval ---
# Points to the freshly built FAISS index (built with all-MiniLM-L6-v2, 384-dim, 7651 vectors)
FAISS_INDEX_DIR=../role1/data/index_minilm

# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=3

# Context similarity threshold: below this score → missing-context refusal.
CONTEXT_SIMILARITY_THRESHOLD=0.35

# Anti-hallucination pre-filter (0.0 = disabled)
RETRIEVAL_MIN_SCORE=0.0

# --- Reliability ---
MAX_RETRIES=3
